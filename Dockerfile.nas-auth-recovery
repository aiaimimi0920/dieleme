ARG BASE_IMAGE=fapaifang-collector:local

FROM ${BASE_IMAGE}

ARG FAPAI_BUILD_VERSION=development
ARG FAPAI_BUILD_COMMIT=unknown
ARG FAPAI_BUILD_TIME=unknown
ARG FAPAI_SOURCE_DIGEST=unknown

ENV FAPAI_BUILD_VERSION=${FAPAI_BUILD_VERSION} \
    FAPAI_BUILD_COMMIT=${FAPAI_BUILD_COMMIT} \
    FAPAI_BUILD_TIME=${FAPAI_BUILD_TIME} \
    FAPAI_SOURCE_DIGEST=${FAPAI_SOURCE_DIGEST}

WORKDIR /app

# Deliberately overlay only the NAS recovery implementation. This keeps an
# unrelated dirty worktree out of the production image while preserving the
# exact dependency and application baseline already running on the NAS.
COPY src/server.py /app/src/server.py
COPY src/nas_auth_recovery.py /app/src/nas_auth_recovery.py

CMD ["python", "tools/docker_entrypoint.py"]
