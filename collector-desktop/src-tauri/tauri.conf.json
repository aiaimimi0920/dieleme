{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FapaiFang Collector Console",
  "version": "0.1.0",
  "identifier": "com.fapaifang.collector",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FapaiFang 运维观察台（PC2 采集）",
        "width": 1280,
        "height": 860,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:8001 http://localhost:8001 http://192.168.15.200:8001; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
